{
  "schemaVersion": 1,
  "description": "Single machine-readable routing authority for WorldForge PR risk and validation scope.",
  "routes": {
    "dependencyAudit": {
      "any": ["^package\\.json$", "^pnpm-lock\\.yaml$", "^pnpm-workspace\\.yaml$"]
    },
    "applicationSecurity": {
      "any": [
        "^(?:apps|packages|migrations)/",
        "^\\.github/workflows/security\\.yml$",
        "^tests/security/",
        "^scripts/(?:scan-secrets|release|verify-package|package-).*\\.mjs$",
        "^package\\.json$",
        "^pnpm-lock\\.yaml$",
        "^pnpm-workspace\\.yaml$"
      ]
    },
    "performance": {
      "any": [
        "^(?:apps|packages|migrations)/",
        "^\\.github/workflows/performance\\.yml$",
        "^tests/performance/",
        "^package\\.json$",
        "^pnpm-lock\\.yaml$",
        "^pnpm-workspace\\.yaml$"
      ]
    },
    "reliability": {
      "any": [
        "^(?:apps|packages|migrations)/",
        "^tests/reliability/",
        "^tests/integration/(?:draft-patch|recovery-|recovery-service|core-).*\\.test\\.ts$",
        "^packages/testkit/src/faults\\.ts$",
        "^scripts/ci-risk-policy\\.mjs$",
        "^docs/process/CI_RISK_MATRIX\\.json$",
        "^\\.github/workflows/quality\\.yml$",
        "^\\.github/workflows/quality-core\\.yml$"
      ]
    },
    "packageSmoke": {
      "any": [
        "^package\\.json$",
        "^pnpm-lock\\.yaml$",
        "^pnpm-workspace\\.yaml$",
        "^scripts/package-desktop\\.mjs$",
        "^scripts/package-foundation\\.mjs$",
        "^scripts/prune-desktop-dist\\.mjs$",
        "^scripts/release-tool\\.mjs$",
        "^scripts/release-acceptance\\.mjs$",
        "^\\.github/workflows/release\\.yml$",
        "^\\.github/workflows/quality\\.yml$",
        "^\\.github/workflows/quality-core\\.yml$"
      ]
    },
    "toolchainExport": {
      "any": [
        "^package\\.json$",
        "^pnpm-lock\\.yaml$",
        "^docs/process/CURRENT_WORKSPACE_TOOLCHAIN\\.(?:json|md)$",
        "^\\.github/governance/toolchain-bundle\\.mjs$",
        "^\\.github/workflows/toolchain-export\\.yml$"
      ]
    },
    "uiAcceptance": {
      "any": [
        "^apps/desktop/renderer/",
        "^apps/desktop/preload/",
        "^apps/desktop/main/",
        "^packages/contracts/",
        "^scripts/check-author-language\\.mjs$",
        "^scripts/check-css-quality\\.mjs$",
        "^scripts/ui-acceptance-gate\\.mjs$",
        "^docs/ui/",
        "^tests/e2e/"
      ]
    },
    "windowsIme": {
      "any": [
        "^apps/desktop/renderer/",
        "^apps/desktop/preload/",
        "^tests/e2e/playwright\\.windows-ime\\.config\\.ts$",
        "^tests/e2e/.*ime.*\\.(?:ts|tsx)$",
        "^scripts/run-electron-e2e\\.mjs$"
      ]
    },
    "governanceMeta": {
      "any": [
        "^\\.github/",
        "^scripts/.*(?:policy|gate|acceptance|verification|automerge|release).*\\.mjs$",
        "^docs/process/",
        "^docs/PROJECT_EXECUTION_ENTRY\\.md$",
        "^AGENTS\\.md$",
        "^agent\\.md$",
        "^package\\.json$",
        "^LICENSE$"
      ]
    }
  },
  "fullQuality": {
    "lightweightOnly": [
      "\\.md$",
      "^docs/",
      "^\\.github/",
      "^scripts/.*policy\\.mjs$",
      "^scripts/automerge\\.mjs$",
      "^scripts/main-verification\\.mjs$",
      "^scripts/ready-closure-route\\.mjs$",
      "^scripts/evidence-policy-entry\\.mjs$",
      "^scripts/license-policy\\.mjs$",
      "^scripts/documentation-consistency\\.mjs$",
      "^scripts/governance-self-check\\.mjs$",
      "^tests/unit/ci-.*\\.test\\.ts$",
      "^tests/unit/quality-system-v2\\.test\\.ts$",
      "^tests/unit/automated-verification-authority\\.test\\.ts$",
      "^tests/unit/evidence-policy\\.test\\.ts$"
    ]
  }
}
