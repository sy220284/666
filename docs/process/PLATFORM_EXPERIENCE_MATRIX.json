{
  "schemaVersion": 2,
  "status": "enforced",
  "authority": "github-actions",
  "description": "Cross-platform author experience authority for Windows, macOS and Linux using current mainstream through high-end desktop viewports.",
  "platforms": [
    {
      "id": "linux",
      "runner": "ubuntu-24.04",
      "display": "xvfb",
      "required": true
    },
    {
      "id": "windows",
      "runner": "windows-latest",
      "display": "native",
      "required": true,
      "nativeIme": "risk-gated-separate-job"
    },
    {
      "id": "macos",
      "runner": "macos-latest",
      "display": "native",
      "required": true
    }
  ],
  "scenario": {
    "spec": "tests/e2e/platform-experience.spec.ts",
    "viewports": [
      {
        "id": "mainstream-fhd",
        "tier": "mainstream",
        "width": 1920,
        "height": 1080
      },
      {
        "id": "mid-high-qhd",
        "tier": "mid-high",
        "width": 2560,
        "height": 1440
      },
      {
        "id": "high-end-4k",
        "tier": "high-end",
        "width": 3840,
        "height": 2160
      }
    ],
    "requiredAssertions": [
      "renderer-ready",
      "quick-create",
      "unicode-draft-save",
      "layout-no-horizontal-overflow",
      "theme-roundtrip",
      "graceful-close"
    ]
  },
  "evidence": {
    "artifactPattern": "platform-experience-{platform}",
    "resultPattern": "test-results/platform-experience/{platform}.json",
    "retentionDays": 14
  },
  "boundaries": {
    "visualRegression": "Linux strict screenshot baseline remains a separate pixel authority and is not part of the platform experience viewport matrix.",
    "windowsIme": "Real Microsoft Pinyin composition remains a dedicated Windows native IME gate.",
    "packageSmoke": "Packaged startup remains independent and cannot substitute for the author experience flow."
  }
}
