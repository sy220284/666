{
  "name": "worldforge",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first desktop writing workstation for a single author",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "package": "node scripts/package-desktop.mjs",
    "package:foundation": "node scripts/package-foundation.mjs",
    "release:check": "node scripts/release-tool.mjs check",
    "release:gate": "node scripts/release-tool.mjs gate",
    "release:checksums": "node scripts/release-tool.mjs checksums",
    "ui:acceptance:gate": "node scripts/ui-acceptance-gate.mjs",
    "evidence:write": "pnpm --filter @worldforge/testkit... build && node scripts/write-test-evidence.mjs",
    "lint": "pnpm check:language && node scripts/test-quality-audit.mjs && eslint . --rule \"@typescript-eslint/no-unused-vars: [error, { argsIgnorePattern: '^_', varsIgnorePattern: '^(_|CandidateSelection$)', caughtErrorsIgnorePattern: '^_', destructuredArrayIgnorePattern: '^_' }]\"",
    "format": "prettier --write \"scripts/**/*.mjs\" \"apps/**/*.{ts,json,mjs,html,css}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"evals/**/*.{json,yaml,yml}\" \".github/**/*.{yaml,yml,json,md}\" \"*.{json,yaml,yml,mjs,ts}\"",
    "format:check": "prettier --write scripts/branch-hygiene.mjs scripts/release-tool.mjs apps/desktop/renderer/src/runtime/renderer-foundation-runtime.ts tests/unit/release-tool.test.ts && git diff -- scripts/branch-hygiene.mjs scripts/release-tool.mjs apps/desktop/renderer/src/runtime/renderer-foundation-runtime.ts tests/unit/release-tool.test.ts && exit 1",
    "typecheck": "pnpm --filter @worldforge/domain build && pnpm --filter @worldforge/contracts build && pnpm --filter @worldforge/prompts build && pnpm --filter @worldforge/editor-core build && pnpm --filter @worldforge/core-service build && pnpm -r --if-present typecheck",
    "test:prepare": "pnpm --filter @worldforge/domain build && pnpm --filter @worldforge/contracts build && pnpm --filter @worldforge/prompts build && pnpm --filter @worldforge/editor-core build && pnpm --filter @worldforge/core-service build",
    "test": "pnpm test:prepare && vitest run && pnpm test:e2e -- --ci-only",
    "test:unit": "pnpm test:prepare && vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && node scripts/run-electron-e2e.mjs",
    "test:security": "vitest run tests/security",
    "test:migration": "pnpm test:prepare && vitest run tests/migration",
    "test:perf": "pnpm test:prepare && vitest run tests/performance --no-file-parallelism",
    "test:eval": "pnpm test:prepare && vitest run tests/performance/ai-output-protocol.test.ts tests/performance/ai-eval-baseline.test.ts",
    "check:language": "node scripts/check-author-language.mjs",
    "check:structure": "node scripts/check-source-structure.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-source-structure.mjs",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "ci:policy": "node scripts/workflow-structure-policy.mjs && node scripts/ci-policy.mjs",
    "ci:evidence": "node scripts/evidence-policy.mjs",
    "ci:ruleset": "node scripts/ruleset-policy.mjs check",
    "task:status": "node .github/governance/single-work-taskctl.mjs status",
    "task:validate": "node .github/governance/single-work-taskctl.mjs validate",
    "task:preflight": "node .github/governance/single-work-taskctl.mjs preflight",
    "task:branch-check": "node .github/governance/single-work-taskctl.mjs branch-check",
    "task:verify": "node .github/governance/single-work-taskctl.mjs validate",
    "task:verify-final": "node .github/governance/single-work-taskctl.mjs validate",
    "test:coverage": "pnpm test:prepare && vitest run --config vitest.coverage.config.ts",
    "test:quality": "node scripts/test-quality-audit.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@worldforge/contracts": "workspace:*",
    "electron": "43.1.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "fflate": "0.8.2",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
